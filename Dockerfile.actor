# Dockerfile.actor — shared actor process image
#
# One image for both ArmAgent and AGVAgent.  The agent class is selected at
# runtime by the ACTOR_KIND environment variable (set by the reconciler).
#
# Build context: repo root
#   docker build -f Dockerfile.actor -t interact-shared-actor .
#
# Required env at runtime (set by container_manager.reconcile_actors):
#   ACTOR_ID     e.g. "arm-1", "agv-1"
#   ACTOR_KIND   "arm" or "agv"
#   REDIS_URL    e.g. "redis://redis:6379/0"
#   INTERACT_BUS=redis
#   INTERACT_STATE=redis
#
# Optional:
#   CONFIG_URL   Backend /config URL (not used for profile loading today;
#                pipeline.yaml is mounted at /interact/pipeline.yaml).
#   PIPELINE_CONFIG  Override the pipeline.yaml path (default: /interact/pipeline.yaml).

FROM python:3.11-slim

WORKDIR /interact

# Install Python dependencies first (layer cached unless requirements change).
COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

# Copy only what actor_runner.py needs:
#   app/agents/   — agent classes, bus, capability, negotiation
#   app/models/   — pipeline_config, agv_state, arm_state, grid_state, redis_lock
#   app/routes/agv_routes.py — promoted handshake helpers (signal_load, poll_load, etc.)
#   app/__init__.py — needed for package resolution; socketio imports are best-effort
#   scripts/actor_runner.py — the entrypoint
#   pipeline.yaml — actor profile source (mounted or baked in)
COPY app/ ./app/
COPY scripts/actor_runner.py ./scripts/actor_runner.py
COPY pipeline.yaml ./pipeline.yaml

# Flush stdout/stderr immediately — critical for log streaming.
ENV PYTHONUNBUFFERED=1

# Default backend selection: redis for both bus and state.
ENV INTERACT_BUS=redis
ENV INTERACT_STATE=redis

# Lightweight health check: verify the python process is running.
HEALTHCHECK --interval=15s --timeout=5s --start-period=10s --retries=3 \
    CMD pgrep -x python > /dev/null || exit 1

CMD ["python", "scripts/actor_runner.py"]
