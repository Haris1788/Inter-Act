FROM python:3.11-slim

WORKDIR /arm

# Install only what the arm microservice needs
RUN pip install --no-cache-dir flask requests

# Copy arm scripts (includes bus_client.py + events.py — the Phase-2 event
# taxonomy lives in scripts/ so actor containers don't need app/).
COPY scripts/ ./scripts/

EXPOSE 8000

CMD ["python", "scripts/arm_server.py"]
